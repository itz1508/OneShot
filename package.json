{
  "name": "oneshot",
  "version": "0.0.0",
  "private": true,
  "description": "OneShot monorepo root. Scripts only; no runtime deps.",
  "scripts": {
    "frontend:dev": "pnpm --filter ./apps/web dev",
    "frontend:build": "pnpm --filter ./apps/web build",
    "backend:install": "uv sync",
    "backend:test": "uv run --package rsm pytest apps/rsm/tests"
  },
  "packageManager": "pnpm@9.15.0"
}
