{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OneShot template Quality Input (declarative; no execution authority)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "template_id", "task_id", "request_id", "original_request", "context_refs",
    "accepted_decision_refs", "unknowns", "readiness"
  ],
  "properties": {
    "template_id": {"enum": ["research", "plan", "build"]},
    "task_id": {"type": "string", "minLength": 1},
    "request_id": {"type": "string", "minLength": 1},
    "original_request": {"type": "string", "minLength": 1},
    "context_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "accepted_decision_refs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "source_scope": {"type": "string", "minLength": 1},
    "research_id": {"type": "string", "minLength": 1},
    "plan_id": {"type": "string", "minLength": 1},
    "approval_ref": {"type": "string", "minLength": 1},
    "unknowns": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["field", "reason", "blocking"],
        "properties": {
          "field": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "blocking": {"type": "boolean"}
        }
      }
    },
    "readiness": {"enum": ["ready", "blocked"]}
  },
  "allOf": [
    {
      "if": {"properties": {"readiness": {"const": "ready"}}, "required": ["readiness"]},
      "then": {"properties": {"unknowns": {"not": {"contains": {"properties": {"blocking": {"const": true}}, "required": ["blocking"]}}}}}
    },
    {
      "if": {"properties": {"readiness": {"const": "blocked"}}, "required": ["readiness"]},
      "then": {"properties": {"unknowns": {"contains": {"properties": {"blocking": {"const": true}}, "required": ["blocking"]}}}}
    },
    {
      "if": {"properties": {"template_id": {"const": "build"}, "readiness": {"const": "ready"}}, "required": ["template_id", "readiness"]},
      "then": {"required": ["plan_id", "approval_ref"]}
    }
  ]
}
