{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/itz1508/OneShot/schemas/output_repo_summary.json",
  "title": "Repository Summary Output",
  "description": "JSON output contract for the repository summary capability. Derived from tools/repo_summary.py RepoSummary dataclass. Cross-stage output available at any workflow stage.",
  "type": "object",
  "required": ["repository", "branch", "commit_sha", "working_tree_clean", "files", "gap_matrix", "available_tools", "color_eval_baseline"],
  "properties": {
    "repository": { "type": "string", "description": "Repository URL" },
    "branch": { "type": "string" },
    "commit_sha": { "type": "string" },
    "working_tree_clean": { "type": "boolean" },
    "files": {
      "type": "array",
      "items": { "type": "string" },
      "description": "List of tracked file paths"
    },
    "gap_matrix": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["area", "requirement", "current_state", "action", "evidence", "color_eval"],
        "properties": {
          "area": { "type": "string" },
          "requirement": { "type": "string" },
          "current_state": { "type": "string" },
          "action": { "enum": ["build", "adapt", "preserve", "retire"] },
          "evidence": { "type": "string" },
          "color_eval": { "enum": ["GREEN", "YELLOW", "RED"] }
        }
      }
    },
    "available_tools": {
      "type": "array",
      "items": { "type": "string" }
    },
    "color_eval_baseline": { "enum": ["GREEN", "YELLOW", "RED"] }
  }
}
