# syntax=docker/dockerfile:1
# Next.js UI image (docs/deployment.md). Build context = repo root:
#   docker build -f deploy/Dockerfile.web -t oneshot-web:local .
FROM node:20-bookworm-slim

# pnpm exactly as pinned by the root package.json "packageManager" field
# (pnpm@9.15.0), activated through corepack. Playwright browsers are NOT
# downloaded: E2E runs on the host (tests/frontend/e2e), never in this image.
RUN corepack enable
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
    NEXT_TELEMETRY_DISABLED=1 \
    PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

WORKDIR /app
# node owns /app so pnpm (workspace root node_modules) and next build can
# write as the non-root user for the whole build AND at runtime.
RUN chown node:node /app
USER node

# Layer 1 — manifests only: dependencies cached until a lockfile/manifest
# changes.
COPY --chown=node:node package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY --chown=node:node apps/web/package.json apps/web/package.json
COPY --chown=node:node packages/rsm-client/package.json packages/rsm-client/package.json
RUN pnpm install --frozen-lockfile

# Layer 2 — sources.
COPY --chown=node:node apps/web apps/web
COPY --chown=node:node packages/rsm-client packages/rsm-client

# NEXT_PUBLIC_* is inlined at build time (apps/web/src/lib/rsm.ts).
# Default = host loopback, matching the compose port publish of the daemon.
ARG NEXT_PUBLIC_RSM_BASE_URL=http://127.0.0.1:8787
ENV NEXT_PUBLIC_RSM_BASE_URL=${NEXT_PUBLIC_RSM_BASE_URL}

RUN pnpm --filter ./apps/web build

ENV PORT=3000 \
    HOSTNAME=0.0.0.0
EXPOSE 3000
CMD ["pnpm", "--filter", "./apps/web", "start"]