# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Tooling caches
.ruff_cache/
.pytest_cache/
.mypy_cache/
uv.lock.bak

# RSM runtime store (default ./ .rsm-store root — state, never source)
.rsm-store/

# Scratch (local TEMP override used for pytest on this host)
.tmp/

# Node
node_modules/
.next/
.turbo/

# Playwright run artifacts (generated; fixtures under tests/ are committed)
test-results/
playwright-report/
blob-report/
.playwright/

# OS/editor
.DS_Store
.idea/
.vscode/

# Build/packaging artifacts (generated, not source)
auto-rsm-0.3.3-export.zip
new-rsm.zip
rsm-v1.zip
rsm-ui-*.vsix

# RSM working folder: contains a built .vsix plus the installer/test sources.
# The .vsix is ignored above; the scripts are real source and stay tracked.
rsm-0.3.3-fixed/FIXED-SHA.txt
rsm-0.3.3-fixed/*.log

# Deploy rollback bookkeeping written on the deployment host by deploy/deploy.sh
.deploy-prev-tag

